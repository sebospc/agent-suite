{
  "_note": "Default cockpit config, a starting point for a project's .cockpit.json (the adopt skill copies it). {project} is the project's folder, {suite} this suite's. Merged over ~/.config/cockpit/config.json; unknown keys and wrong types stop the cockpit at start. One project's real config: examples/first-project/.cockpit.json.",
  "port": 8765,
  "paths": {
    "_note": "Where the cockpit reads (cockpit/docs/DATA_SOURCES.md). Everything here is read only, except ask_owner.py answer, the controls typed into panes, and the cockpit's own folder ~/.cockpit.",
    "board_dir": "~/.agent-board",
    "milestone_dir": "~/.agent-board",
    "bd_command": [
      "bd",
      "export",
      "--all"
    ],
    "panel": "~/.agent-board/panel.json",
    "ask_owner": [
      "python3",
      "{suite}/tools/team/ask_owner.py"
    ],
    "transcripts": "~/.claude/projects",
    "engram_bin": "~/.local/bin/engram",
    "engram_db": "~/.engram/engram.db",
    "engram_project": "your-project",
    "cswap_profiles": "~/.claude-swap-backup/sessions",
    "default_sessions": "~/.claude/sessions",
    "default_settings": "~/.claude/settings.json",
    "herdr": [
      "herdr"
    ],
    "usage": "~/.cockpit/usage.json",
    "balancer_log": "~/.claude/handoff/state/decisions.jsonl",
    "repo": "{project}",
    "repos": [
      "{project}"
    ],
    "landing_ref": "main",
    "gate_logs": "panel.json scratch",
    "team_json": "~/.agent-board/team.json",
    "node": "node",
    "grill_server": "{project}/.claude/skills/grill-with-ui/server.mjs",
    "grill_doc": "~/.cockpit/grill-asks.md",
    "action_log": "~/.cockpit/actions.jsonl",
    "learned_log": "~/.cockpit/learned.jsonl",
    "docs_not_describing_code": [
      "docs/DECISIONS.md"
    ],
    "metrics_log": "~/.cockpit/metrics.jsonl",
    "jev_record": "~/.cockpit/jev_record.jsonl",
    "jev_calls": "~/.cockpit/jev_calls.jsonl",
    "jev_answers": "~/.cockpit/jev_answers.json",
    "pause_file": "~/.agent-board/paused",
    "disk_volume": "/System/Volumes/Data",
    "disk_folders": {
      "transcripts": "~/.claude/projects",
      "board": "~/.agent-board",
      "cockpit": "~/.cockpit"
    },
    "saved_guard_log": "~/.agent-board/saved_guard.jsonl",
    "hook_settings": [
      "~/.claude/settings.json",
      "{project}/.claude/settings.json",
      "{project}/.claude/settings.local.json"
    ],
    "hook_logs": {
      "pick_account": "~/.claude/handoff/state/decisions.jsonl",
      "commit_guard": "~/.agent-board/saved_guard.jsonl",
      "pause_guard": "~/.agent-board/pause_denials.jsonl"
    },
    "rtk": [
      "/opt/homebrew/bin/rtk"
    ],
    "rtk_scratchpads": "/private/tmp/claude-*/*",
    "context_mode_transcripts": "~/.claude/projects/*/*.jsonl",
    "context_mode_sessions": "~/.cockpit/context-mode/home/context-mode/sessions",
    "guarded_configs": [
      "~/.claude/settings.json",
      "{project}/.claude/settings*.json",
      "{project}/.mcp.json"
    ],
    "config_baseline": "~/.cockpit/config-baseline.json",
    "prices_page": "https://platform.claude.com/docs/en/about-claude/pricing.md",
    "decision_log": "docs/DECISIONS.md"
  },
  "team": {
    "_note": "The team: roles as named in the panes (session_prefix + role). coordinating: the roles that manage, not build.",
    "roles": [
      "lead",
      "coordinator",
      "reviewer",
      "app"
    ],
    "coordinating": [
      "lead",
      "coordinator",
      "reviewer"
    ],
    "known_holders": [
      "owner",
      "claude-cloud"
    ],
    "session_prefix": "agent-",
    "legacy_prefixes": [],
    "decisions_writer": "lead"
  }
}
